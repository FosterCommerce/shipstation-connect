{% import "_includes/forms" as forms %}

<div class="field">
	<div class="heading">
		<label>{{ "Custom XML Page URL"|t('shipstationconnect') }}</label>
		<div class="instructions">
			<p>{{ "When setting up your ShipStation Custom Store, enter this URL so ShipStation can retrieve and update orders for this integration."|t('shipstationconnect') }}</p>
		</div>
	</div>
	<div class="input" style="margin-left: 2em;">
		{% if provider.handle %}
			<pre><code>{{ siteUrl('shipstationconnect/shipments/' ~ provider.handle) }}</code></pre>
		{% else %}
			<em>{{ "Save the integration to see the URL."|t('shipstationconnect') }}</em>
		{% endif %}
	</div>
</div>

{{ forms.autosuggestField({
	label: "Username"|t('shipstationconnect'),
	instructions: "HTTP basic auth username ShipStation will send. Leave blank to fall back to the global ShipStation Connect plugin setting."|t('shipstationconnect'),
	name: 'settings[username]',
	value: provider.username,
	class: 'ltr',
	suggestEnvVars: true,
}) }}

{{ forms.autosuggestField({
	label: "Password"|t('shipstationconnect'),
	instructions: "HTTP basic auth password ShipStation will send. Leave blank to fall back to the global ShipStation Connect plugin setting."|t('shipstationconnect'),
	name: 'settings[password]',
	value: provider.password,
	class: 'ltr',
	suggestEnvVars: true,
}) }}

{{ forms.selectField({
	label: "Export filter"|t('shipstationconnect'),
	instructions: "Restrict the export to shipments at this fulfillment status."|t('shipstationconnect'),
	name: 'settings[exportFulfillmentStatus]',
	value: provider.exportFulfillmentStatus,
	options: [{ label: 'No filter'|t('shipstationconnect'), value: '' }]|merge(fulfillmentCases),
}) }}

{{ forms.selectField({
	label: "Shipnotify fulfillment transition"|t('shipstationconnect'),
	instructions: "Fulfillment status applied when ShipStation reports a shipment as shipped."|t('shipstationconnect'),
	name: 'settings[shippedFulfillmentCode]',
	value: provider.shippedFulfillmentCode,
	options: [{ label: "Don’t transition"|t('shipstationconnect'), value: '' }]|merge(fulfillmentCases),
}) }}

{{ forms.selectField({
	label: "Shipnotify shipping transition"|t('shipstationconnect'),
	instructions: "Optional shipping-axis status applied alongside the fulfillment transition."|t('shipstationconnect'),
	name: 'settings[shippedShippingCode]',
	value: provider.shippedShippingCode,
	options: [{ label: "Don’t transition"|t('shipstationconnect'), value: '' }]|merge(shippingCases),
}) }}

{{ forms.lightswitchField({
	label: "Send tax to ShipStation"|t('shipstationconnect'),
	instructions: "Split the parent order’s tax pro-rata across its shipments and send the per-shipment portion. Off by default; tax is a parent-order figure and most stores prefer ShipStation to show $0 tax per shipment."|t('shipstationconnect'),
	name: 'settings[sendTax]',
	on: provider.sendTax,
}) }}

{{ forms.lightswitchField({
	label: "Send shipping cost to ShipStation"|t('shipstationconnect'),
	instructions: "Split the parent order’s shipping cost pro-rata across its shipments and send the per-shipment portion. Off by default; ShipStation usually pulls real carrier cost from the rate it purchases."|t('shipstationconnect'),
	name: 'settings[sendShipping]',
	on: provider.sendShipping,
}) }}

{{ forms.lightswitchField({
	label: "Send discount to ShipStation"|t('shipstationconnect'),
	instructions: "Split the parent order’s discount pro-rata across its shipments and send the per-shipment portion as a coupon adjustment line item. Off by default; discount is a parent-order figure."|t('shipstationconnect'),
	name: 'settings[sendDiscount]',
	on: provider.sendDiscount,
}) }}
