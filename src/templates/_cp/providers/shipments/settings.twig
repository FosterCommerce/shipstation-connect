{% import "_includes/forms" as forms %}

<div class="field">
	<div class="heading">
		<label>{{ 'settings.customXmlPageUrl.label'|t('shipstationconnect') }}</label>
		<div class="instructions">
			<p>{{ 'settings.customXmlPageUrl.instructions'|t('shipstationconnect') }}</p>
		</div>
	</div>
	<div class="input">
		{% if provider.handle %}
			<pre><code>{{ siteUrl('shipstationconnect/shipments/' ~ provider.handle) }}</code></pre>
		{% else %}
			<em>{{ 'settings.customXmlPageUrl.unsavedNotice'|t('shipstationconnect') }}</em>
		{% endif %}
	</div>
</div>

{{ forms.autosuggestField({
	label: 'settings.username.label'|t('shipstationconnect'),
	instructions: 'settings.username.instructions'|t('shipstationconnect'),
	name: 'settings[username]',
	value: provider.username,
	class: 'ltr',
	suggestEnvVars: true,
}) }}

{{ forms.autosuggestField({
	label: 'settings.password.label'|t('shipstationconnect'),
	instructions: 'settings.password.instructions'|t('shipstationconnect'),
	name: 'settings[password]',
	value: provider.password,
	class: 'ltr',
	suggestEnvVars: true,
}) }}

{{ forms.selectField({
	label: 'settings.exportFilter.label'|t('shipstationconnect'),
	instructions: 'settings.exportFilter.instructions'|t('shipstationconnect'),
	name: 'settings[exportFulfillmentStatus]',
	value: provider.exportFulfillmentStatus,
	options: [{ label: 'settings.exportFilter.noFilter'|t('shipstationconnect'), value: '' }]|merge(fulfillmentCases),
}) }}

{{ forms.selectField({
	label: 'settings.shippedFulfillment.label'|t('shipstationconnect'),
	instructions: 'settings.shippedFulfillment.instructions'|t('shipstationconnect'),
	name: 'settings[shippedFulfillmentCode]',
	value: provider.shippedFulfillmentCode,
	options: [{ label: 'settings.dontTransition'|t('shipstationconnect'), value: '' }]|merge(fulfillmentCases),
}) }}

{{ forms.selectField({
	label: 'settings.shippedShipping.label'|t('shipstationconnect'),
	instructions: 'settings.shippedShipping.instructions'|t('shipstationconnect'),
	name: 'settings[shippedShippingCode]',
	value: provider.shippedShippingCode,
	options: [{ label: 'settings.dontTransition'|t('shipstationconnect'), value: '' }]|merge(shippingCases),
}) }}

{{ forms.lightswitchField({
	label: 'settings.sendTax.label'|t('shipstationconnect'),
	instructions: 'settings.sendTax.instructions'|t('shipstationconnect'),
	name: 'settings[sendTax]',
	on: provider.sendTax,
}) }}

{{ forms.lightswitchField({
	label: 'settings.sendShipping.label'|t('shipstationconnect'),
	instructions: 'settings.sendShipping.instructions'|t('shipstationconnect'),
	name: 'settings[sendShipping]',
	on: provider.sendShipping,
}) }}

{{ forms.lightswitchField({
	label: 'settings.sendDiscount.label'|t('shipstationconnect'),
	instructions: 'settings.sendDiscount.instructions'|t('shipstationconnect'),
	name: 'settings[sendDiscount]',
	on: provider.sendDiscount,
}) }}
